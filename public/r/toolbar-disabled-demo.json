{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "extends": "none",
  "name": "toolbar-disabled-demo",
  "title": "toolbar-disabled-demo",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "http://localhost:3000/r/toolbar"
  ],
  "files": [
    {
      "path": "components/samples/controls/toolbar/toolbar-disabled-demo.tsx",
      "content": "\"use client\"\n\nimport { IconBold, IconItalic, IconStrikethrough, IconUnderline } from \"@tabler/icons-react\"\nimport { Toolbar, ToolbarGroup, ToolbarItem } from \"@/components/ui/toolbar\"\n\nexport default function ToolbarDemo() {\n  return (\n    <span data-slot=\"layout\">\n      <Toolbar aria-label=\"Toolbars\">\n        <ToolbarGroup aria-label=\"Text Formatting Options\" isDisabled>\n          <ToolbarItem aria-label=\"Bold\" defaultSelected>\n            <IconBold />\n          </ToolbarItem>\n          <ToolbarItem aria-label=\"Italic\">\n            <IconItalic />\n          </ToolbarItem>\n          <ToolbarItem aria-label=\"Underline\">\n            <IconUnderline />\n          </ToolbarItem>\n          <ToolbarItem aria-label=\"Strikethrough\">\n            <IconStrikethrough />\n          </ToolbarItem>\n        </ToolbarGroup>\n      </Toolbar>\n    </span>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:block"
}