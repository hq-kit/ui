      "path": "components/samples/collections/message/message-group.tsx",
      "content": "import { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\"\nimport { Bubble, BubbleContent } from \"@/components/ui/bubble\"\nimport { Message, MessageAvatar, MessageContent, MessageGroup } from \"@/components/ui/message\"\n\nexport default function MessageGroupDemo() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-6 py-12\">\n      <MessageGroup>\n        <Message>\n          <MessageAvatar />\n          <MessageContent>\n            <Bubble variant=\"muted\">\n              <BubbleContent>I checked the registry addresses.</BubbleContent>\n            </Bubble>\n          </MessageContent>\n        </Message>\n        <Message>\n          <MessageAvatar>\n            <Avatar>\n              <AvatarImage alt=\"@avatar\" src=\"/avatars/02.png\" />\n              <AvatarFallback>CN</AvatarFallback>\n            </Avatar>\n          </MessageAvatar>\n          <MessageContent>\n            <Bubble variant=\"muted\">\n              <BubbleContent>The component and example JSON now live under the UI registry.</BubbleContent>\n            </Bubble>\n          </MessageContent>\n        </Message>\n      </MessageGroup>\n    </div>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:block"
