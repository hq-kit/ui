    {
      "path": "components/samples/collections/bubble/bubble-demo.tsx",
      "content": "import { Bubble, BubbleContent, BubbleGroup, BubbleReactions } from \"@/components/ui/bubble\"\n\nexport default function BubbleDemo() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-8 py-12\">\n      <Bubble align=\"end\">\n        <BubbleContent>Hey there! what&apos;s up?</BubbleContent>\n      </Bubble>\n      <BubbleGroup>\n        <Bubble variant=\"muted\">\n          <BubbleContent>Hey! Want to see chat bubbles?</BubbleContent>\n        </Bubble>\n        <Bubble variant=\"muted\">\n          <BubbleContent>I can group messages, switch sides, and keep the whole thread easy to scan.</BubbleContent>\n          <BubbleReactions aria-label=\"Reaction: thumbs up\" role=\"img\">\n            <span>👍</span>\n          </BubbleReactions>\n        </Bubble>\n      </BubbleGroup>\n      <Bubble align=\"end\">\n        <BubbleContent>Sure. Hit me with your best demo.</BubbleContent>\n      </Bubble>\n      <Bubble variant=\"muted\">\n        <BubbleContent>Yes. You are reading a demo that is demoing itself. Very meta. Very on-brand.</BubbleContent>\n        <BubbleReactions aria-label=\"Reactions: thumbs up, fire, eyes, and 2 more\" role=\"img\">\n          <span>👍</span>\n          <span>🔥</span>\n          <span>👀</span>\n          <span>+2</span>\n        </BubbleReactions>\n      </Bubble>\n    </div>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:block"
}