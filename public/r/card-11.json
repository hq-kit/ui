    {
      "path": "components/samples/surfaces/card/card-11.tsx",
      "content": "\"use client\"\n\nimport {\n  IconCircleCheck,\n  IconDots,\n  IconHeart,\n  IconMessage,\n  IconRepeat,\n  IconSend,\n  IconUserPlus\n} from \"@tabler/icons-react\"\nimport { cn } from \"cn\"\nimport { useState } from \"react\"\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\"\nimport { Button } from \"@/components/ui/button\"\nimport { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from \"@/components/ui/card\"\n\nconst CardTweetDemo = () => {\n  const [liked, setLiked] = useState<boolean>(true)\n\n  return (\n    <Card className=\"max-w-md\">\n      <CardHeader className=\"flex items-center justify-between gap-3\">\n        <div className=\"flex items-center gap-3\">\n          <Avatar className=\"ring-2 ring-ring\">\n            <AvatarImage alt=\"Hallie Richards\" src=\"https://cdn.shadcnstudio.com/ss-assets/avatar/avatar-5.png\" />\n            <AvatarFallback>PG</AvatarFallback>\n          </Avatar>\n          <div className=\"flex flex-col gap-0.5\">\n            <CardTitle className=\"flex items-center gap-1 text-sm\">\n              Philip George <IconCircleCheck className=\"size-4 fill-sky-600 stroke-white dark:fill-sky-400\" />\n            </CardTitle>\n            <CardDescription>@philip20</CardDescription>\n          </div>\n        </div>\n        <div className=\"flex items-center gap-2\">\n          <Button size=\"sm\" variant=\"outline\">\n            <IconUserPlus />\n            Follow\n          </Button>\n          <Button aria-label=\"Toggle menu\" size=\"icon\" variant=\"ghost\">\n            <IconDots />\n          </Button>\n        </div>\n      </CardHeader>\n      <CardContent className=\"space-y-6 text-sm\">\n        <img\n          alt=\"Banner\"\n          className=\"aspect-video w-full rounded-md object-cover\"\n          src=\"https://cdn.shadcnstudio.com/ss-assets/components/card/image-6.png?width=350&format=auto\"\n        />\n        <p>\n          Lost in the colors of the night 🌌✨ Sometimes the blur reveals more than clarity.{\" \"}\n          <a className=\"text-sky-600 dark:text-sky-400\" href=\"#\">\n            #AbstractVibes\n          </a>{\" \"}\n          <a className=\"text-sky-600 dark:text-sky-400\" href=\"#\">\n            #Dreamscape\n          </a>{\" \"}\n          <a className=\"text-sky-600 dark:text-sky-400\" href=\"#\">\n            #VisualPoetry\n          </a>\n        </p>\n      </CardContent>\n      <CardFooter className=\"flex items-center gap-1\">\n        <Button onClick={() => setLiked(!liked)} size=\"sm\" variant=\"ghost\">\n          <IconHeart className={cn(liked && \"fill-destructive stroke-destructive\")} />\n          2.1K\n        </Button>\n        <Button size=\"sm\" variant=\"ghost\">\n          <IconMessage />\n          1.4K\n        </Button>\n        <Button size=\"sm\" variant=\"ghost\">\n          <IconRepeat />\n          669\n        </Button>\n        <Button size=\"sm\" variant=\"ghost\">\n          <IconSend />\n          1.1K\n        </Button>\n      </CardFooter>\n    </Card>\n  )\n}\n\nexport default CardTweetDemo\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:block"
}