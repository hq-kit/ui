{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "extends": "none",
  "name": "pagination-complex",
  "title": "pagination-complex",
  "dependencies": [],
  "registryDependencies": [
    "http://localhost:3000/r/pagination",
    "http://localhost:3000/r/select"
  ],
  "files": [
    {
      "path": "components/samples/navigation/pagination/pagination-complex.tsx",
      "content": "import { Pagination } from \"@/components/ui/pagination\"\nimport { Select } from \"@/components/ui/select\"\n\nexport default () => {\n  return (\n    <div className=\"flex w-full flex-col items-center justify-between sm:flex-row\">\n      <div className=\"to-muted-foreground text-sm\">Show 10 to 20 from 100 data</div>\n      <div className=\"flex items-center gap-2\">\n        <Select aria-label=\"Show\" defaultValue={10} name=\"Show\">\n          <Select.Trigger>\n            <Select.Value />\n          </Select.Trigger>\n          <Select.Content>\n            <Select.Item id={10}>10</Select.Item>\n            <Select.Item id={20}>20</Select.Item>\n            <Select.Item id={40}>40</Select.Item>\n            <Select.Item id={100}>100</Select.Item>\n          </Select.Content>\n        </Select>\n        <Pagination>\n          <Pagination.First href=\"#\" />\n          <Pagination.Previous href=\"#\" />\n          <Pagination.Item href=\"#\">1</Pagination.Item>\n          <Pagination.Item isActive>2</Pagination.Item>\n          <Pagination.Item href=\"#\">3</Pagination.Item>\n          <Pagination.Ellipsis />\n          <Pagination.Item href=\"#\">25</Pagination.Item>\n          <Pagination.Next href=\"#\" />\n          <Pagination.Last href=\"#\" />\n        </Pagination>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:block"
}