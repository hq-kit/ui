{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "extends": "none",
  "name": "bubble-popover",
  "title": "bubble-popover",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "http://localhost:3000/r/bubble",
    "http://localhost:3000/r/button",
    "http://localhost:3000/r/popover"
  ],
  "files": [
    {
      "path": "components/samples/collections/bubble/bubble-popover.tsx",
      "content": "import { InfoIcon } from \"lucide-react\"\nimport { Bubble, BubbleContent, BubbleReactions } from \"@/components/ui/bubble\"\nimport { Button } from \"@/components/ui/button\"\nimport { Popover, PopoverContent, PopoverDescription, PopoverHeader, PopoverTitle } from \"@/components/ui/popover\"\n\nexport default function BubblePopoverDemo() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-4 py-12\">\n      <Bubble align=\"end\">\n        <BubbleContent>Run the build script.</BubbleContent>\n      </Bubble>\n      <Bubble variant=\"destructive\">\n        <BubbleContent>Failed to run the command.</BubbleContent>\n        <BubbleReactions>\n          <Popover>\n            <Button\n              aria-label=\"Show error details\"\n              className=\"aria-expanded:text-destructive\"\n              size=\"icon-xs\"\n              variant=\"ghost\"\n            >\n              <InfoIcon />\n            </Button>\n            <PopoverContent>\n              <PopoverHeader>\n                <PopoverTitle className=\"text-sm\">Command failed with exit code 1</PopoverTitle>\n                <PopoverDescription className=\"text-sm\">\n                  ENOENT: no such file or directory, open pnpm-lock.yaml\n                </PopoverDescription>\n              </PopoverHeader>\n            </PopoverContent>\n          </Popover>\n        </BubbleReactions>\n      </Bubble>\n    </div>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:block"
}