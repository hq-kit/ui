{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "enabled": true,
    "actions": {
      "preset": "recommended",
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              {
                "type": true
              }
            ]
          }
        },
        "useSortedAttributes": "on",
        "useSortedProperties": "on"
      }
    }
  },
  "files": {
    "includes": ["**/*.{js,jsx,ts,tsx,json}", "!node_modules", "!.next", "!.source", "!dist"],
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "bracketSpacing": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "enabled": true,
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "none"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useSemanticElements": "off",
        "useValidAnchor": "off"
      },
      "complexity": {
        "useArrowFunction": "error"
      },
      "correctness": {
        "noChildrenProp": "off",
        "noUnknownFunction": "error",
        "noUnusedImports": {
          "fix": "safe",
          "level": "error"
        },
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "error"
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "fix": "safe",
          "level": "info"
        }
      },
      "performance": {
        "noImgElement": "off"
      },
      "preset": "recommended",
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noParameterAssign": "warn",
        "useImportType": "error",
        "useNumberNamespace": "off",
        "useTemplate": {
          "level": "warn",
          "fix": "safe"
        }
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["assert", "error", "info", "warn"]
          }
        },
        "noExplicitAny": "off"
      }
    }
  },
  "tailwind": {
    "mergeFunctions": ["clsx", "cn", "twMerge"],
    "variantFunctions": ["cva", "tv"],
    "attributes": ["class", "className"]
  }
}
