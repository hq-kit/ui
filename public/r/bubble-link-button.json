  "files": [
    {
      "path": "components/samples/collections/bubble/bubble-link-button.tsx",
      "content": "\"use client\"\n\nimport { toast } from \"sonner\"\nimport { Bubble, BubbleContent, BubbleGroup } from \"@/components/ui/bubble\"\n\nexport default function BubbleLinkButtonDemo() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-8 py-12\">\n      <Bubble variant=\"muted\">\n        <BubbleContent>How can I help you today?</BubbleContent>\n      </Bubble>\n      <BubbleGroup>\n        <Bubble align=\"end\" variant=\"tinted\">\n          <BubbleContent onClick={() => toast(\"You clicked forgot password\")}>I forgot my password</BubbleContent>\n        </Bubble>\n        <Bubble align=\"end\" variant=\"tinted\">\n          <BubbleContent onClick={() => toast(\"You clicked help with subscription\")}>\n            I need help with my subscription\n          </BubbleContent>\n        </Bubble>\n        <Bubble align=\"end\" variant=\"tinted\">\n          <BubbleContent onClick={() => toast(\"You clicked something else. Talk to a human.\")}>\n            Something else. Talk to a human.\n          </BubbleContent>\n        </Bubble>\n      </BubbleGroup>\n    </div>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:block"
}