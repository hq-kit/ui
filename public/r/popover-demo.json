{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "extends": "none",
  "name": "popover-demo",
  "title": "popover-demo",
  "dependencies": [],
  "registryDependencies": [
    "http://localhost:3000/r/button",
    "http://localhost:3000/r/field",
    "http://localhost:3000/r/input",
    "http://localhost:3000/r/popover"
  ],
  "files": [
    {
      "path": "components/samples/overlay/popover/popover-demo.tsx",
      "content": "import { Button } from \"@/components/ui/button\"\nimport { Label } from \"@/components/ui/field\"\nimport { Input } from \"@/components/ui/input\"\nimport { Popover, PopoverContent } from \"@/components/ui/popover\"\n\nexport default function PopoverDemo() {\n  return (\n    <Popover>\n      <Button variant=\"outline\">Open popover</Button>\n      <PopoverContent className=\"w-80\">\n        <div className=\"grid gap-4\">\n          <div className=\"space-y-2\">\n            <h4 className=\"font-medium leading-none\">Dimensions</h4>\n            <p className=\"text-muted-foreground text-sm\">Set the dimensions for the layer.</p>\n          </div>\n          <div className=\"grid gap-2\">\n            <div className=\"grid grid-cols-3 items-center gap-4\">\n              <Label htmlFor=\"width\">Width</Label>\n              <Input className=\"col-span-2 h-8\" defaultValue=\"100%\" id=\"width\" />\n            </div>\n            <div className=\"grid grid-cols-3 items-center gap-4\">\n              <Label htmlFor=\"maxWidth\">Max. width</Label>\n              <Input className=\"col-span-2 h-8\" defaultValue=\"300px\" id=\"maxWidth\" />\n            </div>\n            <div className=\"grid grid-cols-3 items-center gap-4\">\n              <Label htmlFor=\"height\">Height</Label>\n              <Input className=\"col-span-2 h-8\" defaultValue=\"25px\" id=\"height\" />\n            </div>\n            <div className=\"grid grid-cols-3 items-center gap-4\">\n              <Label htmlFor=\"maxHeight\">Max. height</Label>\n              <Input className=\"col-span-2 h-8\" defaultValue=\"none\" id=\"maxHeight\" />\n            </div>\n          </div>\n        </div>\n      </PopoverContent>\n    </Popover>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:block"
}