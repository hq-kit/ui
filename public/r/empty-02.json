  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "extends": "none",
  "name": "empty-02",
  "title": "empty-02",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "https://hq-ui.vercel.app/r/button",
    "https://hq-ui.vercel.app/r/empty"
