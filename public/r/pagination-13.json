  "files": [
    {
      "path": "components/samples/navigation/pagination/pagination-13.tsx",
      "content": "import { IconChevronLeft, IconChevronRight } from \"@tabler/icons-react\"\nimport { Pagination, PaginationContent, PaginationItem, PaginationLink } from \"@/components/ui/pagination\"\n\nconst MiniPagination = () => {\n  return (\n    <Pagination>\n      <PaginationContent>\n        <PaginationItem>\n          <PaginationLink aria-label=\"Go to previous page\" href=\"#\" size=\"icon\">\n            <IconChevronLeft className=\"size-4\" />\n          </PaginationLink>\n        </PaginationItem>\n        <PaginationItem>\n          <p aria-live=\"polite\" className=\"text-muted-foreground text-sm\">\n            Page <span className=\"text-foreground\">2</span> of <span className=\"text-foreground\">5</span>\n          </p>\n        </PaginationItem>\n        <PaginationItem>\n          <PaginationLink aria-label=\"Go to next page\" href=\"#\" size=\"icon\">\n            <IconChevronRight className=\"size-4\" />\n          </PaginationLink>\n        </PaginationItem>\n      </PaginationContent>\n    </Pagination>\n  )\n}\n\nexport default MiniPagination\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:block"
}
