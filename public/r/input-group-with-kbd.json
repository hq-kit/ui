    {
      "path": "components/samples/forms/input-group/input-group-with-kbd.tsx",
      "content": "import { CheckIcon, InfoIcon, SearchIcon, SparklesIcon } from \"lucide-react\"\nimport { Description, Field, FieldGroup, Label } from \"@/components/ui/field\"\nimport { InputGroup, InputGroupAddon, InputGroupInput } from \"@/components/ui/input\"\nimport { Kbd, KbdGroup } from \"@/components/ui/kbd\"\nimport { Spinner } from \"@/components/ui/spinner\"\n\nexport default function InputGroupWithKbd() {\n  return (\n    <FieldGroup>\n      <Field>\n        <Label htmlFor=\"input-kbd-22\">Input Group with Kbd</Label>\n        <InputGroup>\n          <InputGroupInput id=\"input-kbd-22\" />\n          <InputGroupAddon>\n            <Kbd>⌘K</Kbd>\n          </InputGroupAddon>\n        </InputGroup>\n        <InputGroup>\n          <InputGroupInput id=\"input-kbd-23\" />\n          <InputGroupAddon align=\"inline-end\">\n            <Kbd>⌘K</Kbd>\n          </InputGroupAddon>\n        </InputGroup>\n        <InputGroup>\n          <InputGroupInput id=\"input-search-apps-24\" placeholder=\"Search for Apps...\" />\n          <InputGroupAddon align=\"inline-end\">Ask AI</InputGroupAddon>\n          <InputGroupAddon align=\"inline-end\">\n            <Kbd>Tab</Kbd>\n          </InputGroupAddon>\n        </InputGroup>\n        <InputGroup>\n          <InputGroupInput id=\"input-search-type-25\" placeholder=\"Type to search...\" />\n          <InputGroupAddon align=\"inline-start\">\n            <SparklesIcon />\n          </InputGroupAddon>\n          <InputGroupAddon align=\"inline-end\">\n            <KbdGroup>\n              <Kbd>Ctrl</Kbd>\n              <Kbd>C</Kbd>\n            </KbdGroup>\n          </InputGroupAddon>\n        </InputGroup>\n      </Field>\n      <Field>\n        <Label htmlFor=\"input-username-26\">Username</Label>\n        <InputGroup>\n          <InputGroupInput defaultValue=\"shadcn\" id=\"input-username-26\" />\n          <InputGroupAddon align=\"inline-end\">\n            <div className=\"flex size-4 items-center justify-center rounded-full bg-green-500 dark:bg-green-800\">\n              <CheckIcon className=\"size-3 text-white\" />\n            </div>\n          </InputGroupAddon>\n        </InputGroup>\n        <Description className=\"text-green-700\">This username is available.</Description>\n      </Field>\n      <InputGroup>\n        <InputGroupInput id=\"input-search-docs-27\" placeholder=\"Search documentation...\" />\n        <InputGroupAddon>\n          <SearchIcon />\n        </InputGroupAddon>\n        <InputGroupAddon align=\"inline-end\">12 results</InputGroupAddon>\n      </InputGroup>\n      <InputGroup data-disabled=\"true\">\n        <InputGroupInput disabled id=\"input-search-disabled-28\" placeholder=\"Search documentation...\" />\n        <InputGroupAddon>\n          <SearchIcon />\n        </InputGroupAddon>\n        <InputGroupAddon align=\"inline-end\">Disabled</InputGroupAddon>\n      </InputGroup>\n      <FieldGroup className=\"grid grid-cols-2 gap-4\">\n        <Field>\n          <Label htmlFor=\"input-group-11\">First Name</Label>\n          <InputGroup>\n            <InputGroupInput id=\"input-group-11\" placeholder=\"First Name\" />\n            <InputGroupAddon align=\"inline-end\">\n              <InfoIcon />\n            </InputGroupAddon>\n          </InputGroup>\n        </Field>\n        <Field>\n          <Label htmlFor=\"input-group-12\">Last Name</Label>\n          <InputGroup>\n            <InputGroupInput id=\"input-group-12\" placeholder=\"Last Name\" />\n            <InputGroupAddon align=\"inline-end\">\n              <InfoIcon />\n            </InputGroupAddon>\n          </InputGroup>\n        </Field>\n      </FieldGroup>\n      <Field data-disabled=\"true\">\n        <Label htmlFor=\"input-group-29\">Loading (&quot;data-disabled=&quot;true&quot;)</Label>\n        <InputGroup>\n          <InputGroupInput defaultValue=\"shadcn\" disabled id=\"input-group-29\" />\n          <InputGroupAddon align=\"inline-end\">\n            <Spinner />\n          </InputGroupAddon>\n        </InputGroup>\n        <Description>This is a description of the input group.</Description>\n      </Field>\n    </FieldGroup>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:block"
}