{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "extends": "none",
  "name": "color-picker-demo",
  "title": "color-picker-demo",
  "dependencies": [
    "react-aria-components"
  ],
  "registryDependencies": [
    "https://hq-ui.vercel.app/r/button",
    "https://hq-ui.vercel.app/r/colors",
    "https://hq-ui.vercel.app/r/input",
    "https://hq-ui.vercel.app/r/popover"
  ],
  "files": [
    {
      "path": "components/samples/colors/color-picker/color-picker-demo.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\nimport { parseColor } from \"react-aria-components/ColorArea\"\nimport { Button } from \"@/components/ui/button\"\nimport { ColorArea, ColorField, ColorPicker, ColorSlider, ColorSwatch } from \"@/components/ui/colors\"\nimport { Input } from \"@/components/ui/input\"\nimport { Popover, PopoverContent } from \"@/components/ui/popover\"\n\nexport default function ColorPickerDemo() {\n  const [color, setColor] = useState(parseColor(\"#123456\"))\n  return (\n    <ColorPicker defaultValue=\"rgb(120,140,200)\" onChange={setColor} value={color}>\n      <Popover>\n        <Button className=\"flex h-fit items-center gap-2 p-2\" variant=\"ghost\">\n          <ColorSwatch />\n          Select color\n        </Button>\n        <PopoverContent>\n          <div className=\"space-y-2\">\n            <ColorArea className=\"w-full\" colorSpace=\"hsl\" xChannel=\"hue\" yChannel=\"lightness\" />\n            <ColorSlider channel=\"saturation\" colorSpace=\"hsl\"></ColorSlider>\n            <ColorField aria-label=\"Color\">\n              <Input />\n            </ColorField>\n          </div>\n        </PopoverContent>\n      </Popover>\n    </ColorPicker>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:block"
}