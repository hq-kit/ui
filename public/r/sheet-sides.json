{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "extends": "none",
  "name": "sheet-sides",
  "title": "sheet-sides",
  "dependencies": [],
  "registryDependencies": [
    "https://hq-ui.vercel.app/r/button",
    "https://hq-ui.vercel.app/r/field",
    "https://hq-ui.vercel.app/r/input",
