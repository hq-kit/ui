{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "extends": "none",
  "name": "bubble-reactions",
  "title": "bubble-reactions",
  "dependencies": [
    "sonner"
  ],
  "registryDependencies": [
    "https://hq-ui.vercel.app/r/bubble",
    "https://hq-ui.vercel.app/r/button"
