  "files": [
    {
      "path": "components/samples/collections/context-menu/context-menu-destructive.tsx",
      "content": "\"use client\"\n\nimport { PencilIcon, ShareIcon, TrashIcon } from \"lucide-react\"\nimport { Pressable } from \"react-aria-components\"\nimport {\n  ContextMenu,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuItem,\n  ContextMenuSeparator\n} from \"@/components/ui/context-menu\"\n\nexport default function ContextMenuDestructive() {\n  return (\n    <ContextMenu>\n      <Pressable>\n        <div className=\"flex aspect-video w-full max-w-xs items-center justify-center rounded-xl border border-dashed text-sm\">\n          <span className=\"pointer-fine:inline-block hidden\">Right click here</span>\n          <span className=\"pointer-coarse:inline-block hidden\">Long press here</span>\n        </div>\n      </Pressable>\n      <ContextMenuContent>\n        <ContextMenuGroup>\n          <ContextMenuItem>\n            <PencilIcon />\n            Edit\n          </ContextMenuItem>\n          <ContextMenuItem>\n            <ShareIcon />\n            Share\n          </ContextMenuItem>\n        </ContextMenuGroup>\n        <ContextMenuSeparator />\n        <ContextMenuGroup>\n          <ContextMenuItem variant=\"destructive\">\n            <TrashIcon />\n            Delete\n          </ContextMenuItem>\n        </ContextMenuGroup>\n      </ContextMenuContent>\n    </ContextMenu>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:block"
}