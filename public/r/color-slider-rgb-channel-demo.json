{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "extends": "none",
  "name": "color-slider-rgb-channel-demo",
  "title": "color-slider-rgb-channel-demo",
  "dependencies": [
    "react-aria-components"
  ],
  "registryDependencies": [
    "http://localhost:3000/r/colors",
    "http://localhost:3000/r/field"
  ],
  "files": [
    {
      "path": "components/samples/colors/color-slider/color-slider-rgb-channel-demo.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\nimport { type Color, parseColor } from \"react-aria-components/ColorSlider\"\nimport { ColorSlider, ColorSliderOutput, ColorSwatch } from \"@/components/ui/colors\"\nimport { Label } from \"@/components/ui/field\"\n\nexport default function ColorSliderChannelsDemo() {\n  const [color, setColor] = useState<Color>(parseColor(\"rgb(255, 0, 0)\"))\n\n  return (\n    <div className=\"flex w-full flex-col gap-2\">\n      <ColorSwatch className=\"w-full rounded-lg border\" color={color.toString(\"hex\")} />\n      <ColorSlider channel=\"red\" colorSpace=\"rgb\" onChange={setColor} value={color}>\n        <Label>Red</Label>\n        <ColorSliderOutput />\n      </ColorSlider>\n      <ColorSlider channel=\"green\" colorSpace=\"rgb\" onChange={setColor} value={color}>\n        <Label>Green</Label>\n        <ColorSliderOutput />\n      </ColorSlider>\n      <ColorSlider channel=\"blue\" colorSpace=\"rgb\" onChange={setColor} value={color}>\n        <Label>Blue</Label>\n        <ColorSliderOutput />\n      </ColorSlider>\n      <ColorSlider channel=\"alpha\" colorSpace=\"rgb\" onChange={setColor} value={color}>\n        <Label>Alpha</Label>\n        <ColorSliderOutput />\n      </ColorSlider>\n    </div>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:block"
}